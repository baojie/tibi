<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/server_label" android:textStyle="bold" />
        <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="https://tibi.example.com" android:inputType="textUri" android:importantForAutofill="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/token_label" android:textStyle="bold" />
        <EditText android:id="@+id/token" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="tibi_…" android:inputType="textPassword" android:importantForAutofill="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/token_help" android:textSize="12sp" android:alpha="0.7" />
        <Button android:id="@+id/save" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/save" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/media" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/media_permission" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/howto" android:alpha="0.8" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/recent" android:textStyle="bold" />
        <LinearLayout android:id="@+id/recent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
